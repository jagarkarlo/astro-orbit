---
import type { AcademicProject } from "../data/profile";

type Props = {
  projects: AcademicProject[];
};

const { projects } = Astro.props;
---

<section class="grid gap-12 border-t border-border bg-canvas px-6 py-20 sm:px-10 lg:grid-cols-[.7fr_1.3fr] lg:gap-24 lg:px-[6vw] lg:py-24" id="academic-work" aria-labelledby="academic-work-title">
  <div class="self-start lg:sticky lg:top-28">
    <p class="font-mono text-xs uppercase text-accent">Earlier projects</p>
    <h2 class="mt-4 text-4xl leading-tight font-semibold sm:text-5xl" id="academic-work-title">Academic projects</h2>
    <p class="mt-6 max-w-md text-sm leading-6 text-muted">University projects spanning 3D graphics, augmented reality, interface design, and desktop software.</p>
  </div>
  <div class="grid sm:grid-cols-2">
    {projects.map((project, index) => (
      <article class="border-t border-border py-7 sm:min-h-80 sm:pr-7 sm:nth-[even]:border-l sm:nth-[even]:pl-7 sm:nth-[even]:pr-0">
        <div class="flex justify-between font-mono text-xs uppercase text-muted">
          <span>{String(index + 1).padStart(2, "0")}</span><time>{project.period}</time>
        </div>
        <h3 class="mt-9 text-2xl leading-tight font-medium sm:text-3xl">{project.title}</h3>
        <p class="mt-3 font-mono text-xs uppercase text-muted">{project.institution}</p>
        <p class="mt-5 text-sm leading-6 text-muted">{project.description}</p>
        <ul class="mt-6 flex list-none flex-wrap gap-2 p-0" aria-label={`${project.title} skills`}>
          {project.stack.map((item) => <li class="border border-border px-2 py-1 font-mono text-xs uppercase text-muted">{item}</li>)}
        </ul>
        {project.links && project.links.length > 0 && (
          <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
            {project.links.map((link) => (
              <a class="font-mono text-xs uppercase text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent" href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>
            ))}
          </p>
        )}
      </article>
    ))}
  </div>
</section>