---
import type { TimelineItem } from "../data/profile";

type Props = {
  id: string;
  label: string;
  title: string;
  items: TimelineItem[];
  tone?: "paper" | "mist";
};

const { id, label, title, items, tone = "paper" } = Astro.props;
const backgrounds = { paper: "bg-canvas", mist: "bg-surface" };
---

<section class:list={["grid gap-12 border-t border-border px-6 py-20 sm:px-10 lg:grid-cols-[.8fr_1.2fr] lg:gap-24 lg:px-[6vw] lg:py-24", backgrounds[tone]]} id={id} aria-labelledby={`${id}-title`}>
  <div class="self-start lg:sticky lg:top-28">
    <p class="font-mono text-xs uppercase text-accent">{label}</p>
    <h2 class="mt-4 text-4xl leading-tight font-semibold sm:text-5xl" id={`${id}-title`}>{title}</h2>
  </div>
  <ol class="m-0 list-none p-0">
    {items.map((item, index) => (
      <li class="grid grid-cols-[2rem_1fr] gap-x-5 gap-y-3 border-t border-border py-7 sm:grid-cols-[2rem_1fr_auto]">
        <span class="font-mono text-xs uppercase text-accent">{String(index + 1).padStart(2, "0")}</span>
        <div>
          <h3 class="text-2xl leading-tight font-medium sm:text-3xl">{item.title}</h3>
          <p class="mt-2 font-mono text-xs uppercase text-muted">{item.organization}</p>
          {item.description && <p class="mt-4 max-w-xl text-sm leading-6 text-muted">{item.description}</p>}
        </div>
        <time class="col-start-2 font-mono text-xs uppercase text-muted sm:col-start-3 sm:row-start-1">{item.period}</time>
      </li>
    ))}
  </ol>
</section>