---
import type { TimelineItem } from "../data/profile";

type Props = {
  items: TimelineItem[];
};

const { items } = Astro.props;
---

<section class="grid gap-12 border-t border-border bg-canvas px-6 py-20 sm:px-10 lg:grid-cols-[.8fr_1.2fr] lg:gap-24 lg:px-[6vw] lg:py-24" id="recognition" aria-labelledby="recognition-title">
  <div>
    <p class="font-mono text-xs uppercase text-accent">Beyond the work</p>
    <h2 class="mt-4 max-w-xl text-4xl leading-tight font-semibold sm:text-5xl" id="recognition-title">Recognition and service</h2>
  </div>
  <div class="border-t border-border">
    {items.map((item) => (
      <article class="grid gap-5 border-b border-border py-7 sm:grid-cols-[.65fr_.85fr_1fr]">
        <div>
          <p class="font-mono text-xs uppercase">{item.organization}</p>
          <time class="mt-2 block font-mono text-xs uppercase text-muted">{item.period}</time>
        </div>
        <h3 class="text-xl font-medium">{item.title}</h3>
        {item.description && <p class="text-sm leading-6 text-muted">{item.description}</p>}
      </article>
    ))}
  </div>
</section>