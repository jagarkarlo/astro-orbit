---
import { Icon } from "astro-icon/components";

const groups = [
  {
    label: "Platform",
    tools: [
      { name: "Kubernetes", icon: "simple-icons:kubernetes", href: "https://kubernetes.io/" },
      { name: "Argo CD", icon: "simple-icons:argo", href: "https://argo-cd.readthedocs.io/" },
      { name: "Docker", icon: "simple-icons:docker", href: "https://www.docker.com/" },
    ],
  },
  {
    label: "Cloud & infrastructure",
    tools: [
      { name: "Azure", icon: "simple-icons:microsoftazure", href: "https://azure.microsoft.com/" },
      { name: "Terraform", icon: "simple-icons:terraform", href: "https://www.terraform.io/" },
      { name: "Linux", icon: "simple-icons:linux", href: "https://www.linux.org/" },
    ],
  },
  {
    label: "Observability",
    tools: [
      { name: "Prometheus", icon: "simple-icons:prometheus", href: "https://prometheus.io/" },
      { name: "Grafana", icon: "simple-icons:grafana", href: "https://grafana.com/" },
      { name: "Loki", icon: "simple-icons:grafana", href: "https://grafana.com/oss/loki/" },
    ],
  },
  {
    label: "Development",
    tools: [
      { name: "TypeScript", icon: "simple-icons:typescript", href: "https://www.typescriptlang.org/" },
      { name: "Python", icon: "simple-icons:python", href: "https://www.python.org/" },
      { name: "GitLab", icon: "simple-icons:gitlab", href: "https://about.gitlab.com/" },
    ],
  },
];
---

<section class="border-y border-border bg-canvas px-6 py-20 sm:px-10 lg:px-[6vw] lg:py-24" aria-labelledby="stack-title" data-reveal>
  <div class="mx-auto grid max-w-[94rem] gap-12 lg:grid-cols-[.6fr_1.4fr] lg:gap-20">
    <div>
      <p class="font-mono text-xs uppercase text-accent">Technical stack</p>
      <h2 class="mt-4 text-4xl leading-tight font-semibold sm:text-5xl" id="stack-title">Tools I use</h2>
      <p class="mt-6 max-w-sm text-sm leading-6 text-muted">The platform, cloud, telemetry, and development tools that recur across my work.</p>
    </div>
    <div class="grid border-t border-border sm:grid-cols-2">
      {groups.map((group) => (
        <section class="border-b border-border py-7 sm:px-7 sm:nth-[odd]:border-r sm:nth-[odd]:pl-0" aria-label={group.label}>
          <h3 class="mb-6 font-mono text-xs uppercase text-muted">{group.label}</h3>
          <ul class="grid list-none gap-4 p-0">
            {group.tools.map((tool) => (
              <li>
                <a class="group flex items-center gap-3 text-sm text-muted no-underline transition-colors hover:text-foreground" href={tool.href} target="_blank" rel="noreferrer">
                  <Icon class="size-4 text-accent" name={tool.icon} aria-hidden="true" />
                  <span>{tool.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>
