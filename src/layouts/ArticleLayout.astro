---
import BaseLayout from "./BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  meta?: string[];
  backHref: string;
  backLabel: string;
}

const { title, description, eyebrow, meta = [], backHref, backLabel } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main id="main-content" class="bg-canvas">
    <header class="border-b border-border px-6 py-16 sm:px-10 lg:px-[6vw] lg:py-24">
      <div class="mx-auto max-w-[62rem]">
        <a class="font-mono text-xs uppercase text-muted no-underline transition-colors hover:text-accent" href={backHref}>
          <span aria-hidden="true">←</span> {backLabel}
        </a>
        <p class="mt-10 font-mono text-xs uppercase text-accent">{eyebrow}</p>
        <h1 class="mt-4 text-4xl leading-[1.05] font-semibold sm:text-5xl lg:text-6xl">{title}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-muted">{description}</p>
        {meta.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 p-0 font-mono text-xs uppercase text-muted">
            {meta.map((item) => <li class="list-none">{item}</li>)}
          </ul>
        )}
      </div>
    </header>
    <div class="px-6 py-16 sm:px-10 lg:px-[6vw] lg:py-20">
      <article class="prose mx-auto max-w-[62rem]">
        <slot />
      </article>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
