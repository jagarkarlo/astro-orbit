---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Terminal from "../components/Terminal.astro";
import { SITE, SOCIALS, withBase } from "../config";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const socialImage = new URL(withBase(SITE.socialImage), Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  url: canonical.toString(),
  sameAs: SOCIALS.map((social) => social.href),
  knowsAbout: SITE.knowsAbout,
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={SITE.themeColor.dark} data-theme-color />
    <script is:inline data-astro-rerun define:vars={{ themeColor: SITE.themeColor, defaultTheme: SITE.defaultTheme }}>
      (() => {
        const storedTheme = localStorage.getItem("portfolio-theme");
        const theme = storedTheme === "light" || storedTheme === "dark" ? storedTheme : defaultTheme;
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.querySelector("[data-theme-color]")?.setAttribute("content", themeColor[theme]);

        document.addEventListener("astro:before-swap", (event) => {
          const active = document.documentElement.dataset.theme;
          event.newDocument.documentElement.dataset.theme = active;
          event.newDocument.documentElement.style.colorScheme = document.documentElement.style.colorScheme;
          event.newDocument.querySelector("[data-theme-color]")?.setAttribute("content", themeColor[active]);
        });
      })();
    </script>
    <link rel="icon" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
    <ClientRouter />
  </head>
  <body>
    <a class="fixed -top-20 left-4 z-50 border border-accent bg-raised px-4 py-3 font-mono text-xs text-foreground focus:top-4" href="#main-content">Skip to content</a>
    <slot />
    <Terminal />
  </body>
</html>