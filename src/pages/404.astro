---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
import SiteHeader from "../components/SiteHeader.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={`Page not found | ${SITE.name}`} description="The requested page could not be found.">
  <SiteHeader />
  <main id="main-content" class="min-h-[calc(100svh-3.5rem)] bg-canvas px-6 py-20 sm:px-10 lg:px-[6vw] lg:py-28">
    <div class="mx-auto max-w-[94rem]">
      <p class="font-mono text-xs uppercase text-accent">Error / 404</p>
      <h1 class="my-12 text-6xl leading-[.92] font-semibold sm:text-7xl lg:text-8xl">Page not found</h1>
      <p class="mb-8 text-lg text-muted">This page is not part of the current build.</p>
      <a class="inline-flex items-center gap-8 border border-accent bg-accent px-5 py-3.5 font-mono text-xs uppercase text-canvas no-underline transition-colors hover:bg-transparent hover:text-accent" href={`${base}/`}>Return home <span aria-hidden="true">←</span></a>
    </div>
  </main>
</BaseLayout>