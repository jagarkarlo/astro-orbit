---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
import Credentials from "../components/Credentials.astro";
import ProfileTimeline from "../components/ProfileTimeline.astro";
import Recognition from "../components/Recognition.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { profile } from "../data/profile";
---

<BaseLayout
  title={`About | ${SITE.name}`}
  description={`Experience, education, perspective, recognition and credentials for ${SITE.name}.`}
>
  <SiteHeader />
  <main id="main-content">
    <header class="bg-canvas px-6 py-20 sm:px-10 lg:px-[6vw] lg:py-28">
      <div class="mx-auto max-w-[94rem]">
        <p class="font-mono text-xs uppercase text-accent">About / Profile</p>
        <h1 class="my-10 text-6xl leading-[.92] font-semibold sm:text-7xl lg:text-8xl">About me</h1>
        <div class="ml-auto grid max-w-5xl gap-8 text-lg leading-8 text-muted sm:grid-cols-2">
          <p>{profile.summary}</p><p>{profile.perspective}</p>
        </div>
        <dl class="ml-auto mt-12 grid max-w-5xl sm:grid-cols-2" aria-label="Profile summary">
          <div class="border-t border-border py-4 sm:pr-6"><dt class="font-mono text-xs uppercase text-muted">Based in</dt><dd class="m-0 mt-2 text-sm">{SITE.location}</dd></div>
          <div class="border-t border-border py-4 sm:pl-6"><dt class="font-mono text-xs uppercase text-muted">Current role</dt><dd class="m-0 mt-2 text-sm">{SITE.role}</dd></div>
          <div class="border-t border-border py-4 sm:pr-6"><dt class="font-mono text-xs uppercase text-muted">Current study</dt><dd class="m-0 mt-2 text-sm">Your degree, level</dd></div>
          <div class="border-t border-border py-4 sm:pl-6"><dt class="font-mono text-xs uppercase text-muted">International</dt><dd class="m-0 mt-2 text-sm">Exchange or relocation</dd></div>
        </dl>
      </div>
    </header>
    <ProfileTimeline id="experience" label="01" title="Experience" items={profile.experience} />
    <ProfileTimeline id="education" label="02" title="Education" items={profile.education} tone="mist" />
    <Recognition items={profile.recognition} />
    <Credentials certifications={profile.certifications} languages={profile.languages} />
  </main>
  <SiteFooter />
</BaseLayout>
