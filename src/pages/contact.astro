---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE, SOCIALS } from "../config";
---

<BaseLayout
  title={`Contact | ${SITE.name}`}
  description={`Get in touch with ${SITE.name}.`}
>
  <SiteHeader />
  <main id="main-content" class="min-h-[calc(100svh-3.5rem)] bg-canvas">
    <section class="px-6 py-20 sm:px-10 lg:px-[6vw] lg:py-28">
      <div class="mx-auto max-w-[94rem]">
        <p class="font-mono text-xs uppercase text-accent">Contact / Open channels</p>
        <h1 class="my-10 max-w-6xl text-6xl leading-[.92] font-semibold sm:text-7xl lg:text-8xl">Get in touch</h1>
        <p class="max-w-3xl text-lg leading-8 text-muted">A short paragraph on what you would like to be contacted about, and where you respond fastest.</p>
        <div class="mt-16 grid max-w-5xl border-t border-border sm:grid-cols-2">
          {SOCIALS.map((social, index) => (
            <a class:list={["group grid grid-cols-[2rem_1fr] gap-3 border-b border-border py-7 no-underline", index % 2 === 0 ? "sm:border-r sm:pr-6" : "sm:pl-6"]} href={social.href} target="_blank" rel="noreferrer"><span class="font-mono text-xs uppercase text-accent">{String(index + 1).padStart(2, "0")}</span><strong class="text-2xl font-medium transition-colors group-hover:text-accent">{social.label}</strong><small class="col-start-2 font-mono text-xs uppercase text-muted">Open profile ↗</small></a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
