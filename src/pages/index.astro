---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrbitalField from "../components/OrbitalField.astro";
import ProjectList from "../components/ProjectList.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TechnologyStack from "../components/TechnologyStack.astro";
import { getCollection } from "astro:content";
import { SITE, withBase } from "../config";

const featured = (await getCollection("projects", ({ data }) => data.featured && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title={`${SITE.name} | ${SITE.headline}`}
  description={SITE.description}
>
  <SiteHeader />
  <main id="main-content">
    <section class="relative flex min-h-[calc(100svh-5.5rem)] overflow-hidden bg-canvas px-6 py-12 sm:px-10 lg:px-[6vw]" aria-labelledby="hero-title" data-reveal>
      <OrbitalField />
      <div class="pointer-events-none relative z-10 mx-auto flex w-full max-w-[94rem] flex-col items-center justify-center text-center">
        <p class="absolute top-0 left-0 flex items-center gap-3 font-mono text-xs uppercase text-muted"><span class="size-1.5 bg-accent"></span> {SITE.location} / {SITE.discipline}</p>
        <div class="portrait-stage">
          <img src={withBase(SITE.portrait)} alt={SITE.name} width="1200" height="1200" fetchpriority="high" />
        </div>
        <div class="mt-7 max-w-3xl">
          <p class="mb-3 font-mono text-xs uppercase text-accent">{SITE.role}</p>
          <h1 class="text-5xl leading-none font-semibold sm:text-6xl lg:text-7xl" id="hero-title">{SITE.name}</h1>
          <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-muted sm:text-lg">{SITE.tagline}</p>
          <div class="pointer-events-auto mt-7 flex flex-wrap items-center justify-center gap-3">
            <a class="inline-flex items-center gap-7 border border-accent bg-accent px-5 py-3 font-mono text-xs uppercase text-canvas no-underline transition-colors hover:bg-transparent hover:text-accent" href={`${base}/work/`}>Explore work <span aria-hidden="true">→</span></a>
            <a class="border border-border bg-surface/70 px-5 py-3 font-mono text-xs uppercase text-foreground no-underline backdrop-blur-md transition-colors hover:border-accent hover:text-accent" href={`${base}/contact/`}>Contact</a>
          </div>
        </div>
      </div>
    </section>

    <TechnologyStack />

    <section class="border-t border-border bg-surface px-5 py-20 sm:px-10 lg:px-[6vw] lg:py-28" aria-labelledby="selected-work-title" data-reveal>
      <div class="mx-auto mb-16 flex max-w-[94rem] flex-col items-start justify-between gap-8 sm:flex-row sm:items-end">
        <div><p class="font-mono text-xs uppercase text-accent">Selected work</p><h2 class="mt-4 text-4xl leading-tight font-semibold sm:text-5xl" id="selected-work-title">Featured projects</h2></div>
        <a class="font-mono text-xs uppercase text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent" href={`${base}/work/`}>View all work <span aria-hidden="true">→</span></a>
      </div>
      <ProjectList projects={featured} />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
