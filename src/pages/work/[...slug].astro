---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { withBase } from "../../config";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, category, summary, outcome, stack, repo, order } = project.data;
---

<ArticleLayout
  title={title}
  description={summary}
  eyebrow={`${String(order).padStart(2, "0")} / ${category}`}
  meta={stack}
  backHref={withBase("/work/")}
  backLabel="All work"
>
  <p class="lead">{outcome}</p>
  <Content />
  <p>
    <a href={repo} target="_blank" rel="noreferrer">View the repository ↗</a>
  </p>
</ArticleLayout>
