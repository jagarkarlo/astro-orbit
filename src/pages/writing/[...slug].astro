---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { withBase } from "../../config";

export async function getStaticPaths() {
  const posts = await getCollection("writing", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags } = post.data;

const formatted = date.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });
const meta = [formatted, ...(updated ? [`Updated ${updated.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}`] : []), ...tags];
---

<ArticleLayout
  title={title}
  description={description}
  eyebrow="Writing"
  meta={meta}
  backHref={withBase("/writing/")}
  backLabel="All writing"
>
  <Content />
</ArticleLayout>
